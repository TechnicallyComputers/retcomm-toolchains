# Upstream pins for cmake-clang-v1 packs. Bump intentionally; CI reads this file.

PACK_ID=cmake-clang-v1

# Kitware CMake (3.31.x — avoids CMake 4.x policy breaks on older projects)
CMAKE_VERSION=3.31.12

# Ninja
NINJA_VERSION=1.13.2

# Linux: official LLVM GitHub "Linux-X64" archive (pruned to clang/lld + resource dir)
LLVM_VERSION=22.1.8
LLVM_TAG=llvmorg-22.1.8
LLVM_LINUX_ASSET=LLVM-22.1.8-Linux-X64.tar.xz

# Windows: mstorsjo llvm-mingw (clang/lld + mingw-w64 UCRT sysroot)
LLVM_MINGW_TAG=20260616
LLVM_MINGW_ASSET=llvm-mingw-20260616-ucrt-x86_64.zip
# Linux-hosted llvm-mingw (same tag) — used only on packager CI to cross-build deps
LLVM_MINGW_LINUX_ASSET=llvm-mingw-20260616-ucrt-ubuntu-22.04-x86_64.tar.xz

# Static zlib for Windows packs (find_package(ZLIB) / savestates)
ZLIB_VERSION=1.3.1

# Linux: Ubuntu jammy libxml2.so.2 for official LLVM lld (hosts may only ship .so.16)
LIBXML2_DEB_VERSION=2.9.13+dfsg-1ubuntu0.12
LIBXML2_DEB_ASSET=libxml2_${LIBXML2_DEB_VERSION}_amd64.deb
LIBXML2_DEB_URL=http://archive.ubuntu.com/ubuntu/pool/main/libx/libxml2/${LIBXML2_DEB_ASSET}
