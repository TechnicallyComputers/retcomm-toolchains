# Upstream pins for cmake-clang-v1 packs. Bump intentionally; CI reads this file.

PACK_ID=cmake-clang-v1

# Kitware CMake (3.31.x — avoids CMake 4.x policy breaks on older projects)
CMAKE_VERSION=3.31.12

# Ninja
NINJA_VERSION=1.13.2

# ccache (official prebuilt binaries — musl-static on Linux for host portability)
CCACHE_VERSION=4.13.6

# Linux: official LLVM GitHub "Linux-X64" archive (pruned to clang/lld + resource dir)
LLVM_VERSION=22.1.8
LLVM_TAG=llvmorg-22.1.8
LLVM_LINUX_ASSET=LLVM-22.1.8-Linux-X64.tar.xz

# Windows: mstorsjo llvm-mingw (clang/lld + mingw-w64 UCRT sysroot)
LLVM_MINGW_TAG=20260616
LLVM_MINGW_ASSET=llvm-mingw-20260616-ucrt-x86_64.zip
# Linux-hosted llvm-mingw (same tag) — used only on packager CI to cross-build deps
LLVM_MINGW_LINUX_ASSET=llvm-mingw-20260616-ucrt-ubuntu-22.04-x86_64.tar.xz

# Static zlib for Windows packs (find_package(ZLIB) / savestates)
ZLIB_VERSION=1.3.1

# Prebuilt static SDL3 (same pin as psxrecomp FetchContent fallback).
# Skips per-title FetchContent try_compile storms on first Windows/Linux configure.
SDL3_VERSION=3.4.10
SDL3_TARBALL=SDL3-${SDL3_VERSION}.tar.gz
SDL3_URL=https://github.com/libsdl-org/SDL/releases/download/release-${SDL3_VERSION}/${SDL3_TARBALL}
SDL3_SHA256=12b34280415ec8418c864408b93d008a20a6530687ee613d60bfbd20411f2785

# Linux: Ubuntu jammy libxml2.so.2 for official LLVM lld (hosts may only ship .so.16)
LIBXML2_DEB_VERSION=2.9.13+dfsg-1ubuntu0.12
LIBXML2_DEB_ASSET=libxml2_${LIBXML2_DEB_VERSION}_amd64.deb
LIBXML2_DEB_URL=http://archive.ubuntu.com/ubuntu/pool/main/libx/libxml2/${LIBXML2_DEB_ASSET}

# Linux: Ubuntu jammy libicu70 for libxml2→lld (Fedora/Cachy ship ICU 78; SONAME .70 missing)
LIBICU70_DEB_VERSION=70.1-2
LIBICU70_DEB_ASSET=libicu70_${LIBICU70_DEB_VERSION}_amd64.deb
LIBICU70_DEB_URL=http://archive.ubuntu.com/ubuntu/pool/main/i/icu/${LIBICU70_DEB_ASSET}

# Linux build sysroot (Ubuntu jammy amd64) — SteamOS / headerless hosts.
# clang.cfg --sysroot=<CFGDIR>/../sysroot; RetComM passes -DCMAKE_SYSROOT.
# Runtime still uses the host's libc/libGL (DT_NEEDED SONAMEs); these files are
# for compile + link only. Prefer archive.ubuntu.com / security.ubuntu.com.
SYSROOT_GLIBC_VERSION=2.35-0ubuntu3.14
SYSROOT_LINUX_LIBC_DEV_VERSION=5.15.0-187.197
SYSROOT_GCC12_VERSION=12.3.0-1ubuntu1~22.04.3
SYSROOT_GLVND_VERSION=1.4.0-1
SYSROOT_ZLIB_DEB_VERSION=1.2.11.dfsg-2ubuntu9.2

SYSROOT_LIBC6_DEB=libc6_${SYSROOT_GLIBC_VERSION}_amd64.deb
SYSROOT_LIBC6_DEV_DEB=libc6-dev_${SYSROOT_GLIBC_VERSION}_amd64.deb
SYSROOT_LINUX_LIBC_DEV_DEB=linux-libc-dev_${SYSROOT_LINUX_LIBC_DEV_VERSION}_amd64.deb
SYSROOT_LIBGCC_S1_DEB=libgcc-s1_${SYSROOT_GCC12_VERSION}_amd64.deb
SYSROOT_LIBSTDCPP6_DEB=libstdc++6_${SYSROOT_GCC12_VERSION}_amd64.deb
SYSROOT_LIBSTDCPP_DEV_DEB=libstdc++-12-dev_${SYSROOT_GCC12_VERSION}_amd64.deb
SYSROOT_LIBGLVND0_DEB=libglvnd0_${SYSROOT_GLVND_VERSION}_amd64.deb
SYSROOT_LIBGL1_DEB=libgl1_${SYSROOT_GLVND_VERSION}_amd64.deb
SYSROOT_LIBGLX0_DEB=libglx0_${SYSROOT_GLVND_VERSION}_amd64.deb
SYSROOT_LIBGLVND_DEV_DEB=libglvnd-dev_${SYSROOT_GLVND_VERSION}_amd64.deb
SYSROOT_LIBGL_DEV_DEB=libgl-dev_${SYSROOT_GLVND_VERSION}_amd64.deb
SYSROOT_ZLIB1G_DEB=zlib1g_${SYSROOT_ZLIB_DEB_VERSION}_amd64.deb
SYSROOT_ZLIB1G_DEV_DEB=zlib1g-dev_${SYSROOT_ZLIB_DEB_VERSION}_amd64.deb

SYSROOT_SEC_POOL=http://security.ubuntu.com/ubuntu/pool
SYSROOT_ARC_POOL=http://archive.ubuntu.com/ubuntu/pool
SYSROOT_LIBC6_URL=${SYSROOT_SEC_POOL}/main/g/glibc/${SYSROOT_LIBC6_DEB}
SYSROOT_LIBC6_DEV_URL=${SYSROOT_SEC_POOL}/main/g/glibc/${SYSROOT_LIBC6_DEV_DEB}
SYSROOT_LINUX_LIBC_DEV_URL=${SYSROOT_SEC_POOL}/main/l/linux/${SYSROOT_LINUX_LIBC_DEV_DEB}
SYSROOT_LIBGCC_S1_URL=${SYSROOT_SEC_POOL}/main/g/gcc-12/${SYSROOT_LIBGCC_S1_DEB}
SYSROOT_LIBSTDCPP6_URL=${SYSROOT_SEC_POOL}/main/g/gcc-12/${SYSROOT_LIBSTDCPP6_DEB}
SYSROOT_LIBSTDCPP_DEV_URL=${SYSROOT_ARC_POOL}/universe/g/gcc-12/${SYSROOT_LIBSTDCPP_DEV_DEB}
SYSROOT_LIBGLVND0_URL=${SYSROOT_ARC_POOL}/main/libg/libglvnd/${SYSROOT_LIBGLVND0_DEB}
SYSROOT_LIBGL1_URL=${SYSROOT_ARC_POOL}/main/libg/libglvnd/${SYSROOT_LIBGL1_DEB}
SYSROOT_LIBGLX0_URL=${SYSROOT_ARC_POOL}/main/libg/libglvnd/${SYSROOT_LIBGLX0_DEB}
SYSROOT_LIBGLVND_DEV_URL=${SYSROOT_ARC_POOL}/main/libg/libglvnd/${SYSROOT_LIBGLVND_DEV_DEB}
SYSROOT_LIBGL_DEV_URL=${SYSROOT_ARC_POOL}/main/libg/libglvnd/${SYSROOT_LIBGL_DEV_DEB}
SYSROOT_ZLIB1G_URL=${SYSROOT_SEC_POOL}/main/z/zlib/${SYSROOT_ZLIB1G_DEB}
SYSROOT_ZLIB1G_DEV_URL=${SYSROOT_SEC_POOL}/main/z/zlib/${SYSROOT_ZLIB1G_DEV_DEB}

# Embeddable CPython (astral-sh/python-build-standalone install_only_stripped)
# Used by RetComM generate (psxrecomp / snesrecomp / …) — no system Python required.
PYTHON_VERSION=3.12.13
PYTHON_PBS_TAG=20260807
PYTHON_PBS_URL_PREFIX=https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_PBS_TAG}
